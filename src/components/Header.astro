<!-- Mobile Menu Toggle -->
<button
  class="mobile-nav-toggle fixed top-6 right-6 z-50 lg:hidden w-12 h-12 rounded-full bg-primary-500 text-white flex items-center justify-center shadow-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-dark-bg"
  aria-label="Toggle navigation menu"
  aria-expanded="false"
  aria-controls="header"
>
  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" id="menu-open" d="M4 6h16M4 12h16M4 18h16" />
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" id="menu-close" class="hidden" d="M6 18L18 6M6 6l12 12" />
  </svg>
</button>

<!-- Mobile Overlay -->
<div class="mobile-nav-overlay fixed inset-0 bg-black/50 z-40 hidden lg:hidden" aria-hidden="true"></div>

<script>
  const toggle = document.querySelector('.mobile-nav-toggle');
  const header = document.getElementById('header');
  const overlay = document.querySelector('.mobile-nav-overlay');
  const menuOpen = toggle.querySelector('#menu-open');
  const menuClose = toggle.querySelector('#menu-close');

  const closeMenu = () => {
    header.classList.add('-translate-x-full');
    overlay.classList.add('hidden');
    toggle.setAttribute('aria-expanded', 'false');
    menuOpen.classList.remove('hidden');
    menuClose.classList.add('hidden');
    document.body.style.overflow = '';
  };

  const openMenu = () => {
    header.classList.remove('-translate-x-full');
    overlay.classList.remove('hidden');
    toggle.setAttribute('aria-expanded', 'true');
    menuOpen.classList.add('hidden');
    menuClose.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  };

  toggle.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    isExpanded ? closeMenu() : openMenu();
  });

  overlay.addEventListener('click', closeMenu);

  // Close on nav link click
  header.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      closeMenu();
    }
  });
</script>

<style>
  /* Ensure smooth transitions */
  #header {
    transition: transform 0.3s ease-in-out;
  }

  @media (max-width: 1023px) {
    #header {
      transform: translateX(100%);
    }

    #header:not(.-translate-x-full) {
      transform: translateX(0);
    }
  }
</style>