---
// Portfolio Section Component
import { getCollection } from 'astro:content';
import { withBase, imageSrc } from '@/utils/paths';

const projects = await getCollection('projects');
const featuredProjects = projects.filter(p => p.data.featured).sort((a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime());
const otherProjects = projects.filter(p => !p.data.featured).sort((a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime());

const categories = ['All', 'Featured', 'Web', 'System', 'Mobile', 'Other'];
---

<section id="portfolio" class="section bg-gray-50 dark:bg-dark-card" aria-labelledby="portfolio-heading">
  <div class="container-custom lg:pl-72">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-block px-3 py-1 rounded-full bg-primary-500/10 text-primary-600 dark:text-primary-400 text-sm font-medium mb-4">My Work</span>
      <h2 id="portfolio-heading" class="section-title">Selected Projects</h2>
      <p class="section-subtitle mt-4">
        A collection of systems and applications I've built, ranging from hospital management systems to web applications.
      </p>
    </div>

    <!-- Filter Tabs -->
    <div class="flex flex-wrap justify-center gap-2 mb-10" role="tablist" aria-label="Project categories">
      {categories.map((cat, index) => (
        <button
          class="filter-btn px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 {index === 0 ? 'bg-primary-500 text-white shadow-lg' : 'bg-white dark:bg-dark-card text-gray-600 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/20 hover:text-primary-600 dark:hover:text-primary-400 border border-gray-100 dark:border-dark-border'}"
          role="tab"
          aria-selected={index === 0}
          aria-controls={`panel-${cat.toLowerCase()}`}
          id={`tab-${cat.toLowerCase()}`}
          data-filter={cat.toLowerCase()}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Featured Projects Grid -->
    <div id="panel-featured" role="tabpanel" aria-labelledby="tab-featured" class="space-y-8">
      {featuredProjects.map((project, index) => (
        <article class="card overflow-hidden animate-fade-in animate-slide-up" style={`animation-delay: ${index * 100}ms`}>
          <div class="lg:grid lg:grid-cols-2 gap-0">
            <div class="relative aspect-video lg:aspect-auto min-h-[300px] overflow-hidden">
              <img
                src={imageSrc(project.data.image)}
                alt=""
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading={index < 3 ? 'eager' : 'lazy'}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-6 left-6 right-6 text-white">
                <span class="badge-primary mb-2 inline-block">{project.data.category.charAt(0).toUpperCase() + project.data.category.slice(1)}</span>
                <h3 class="text-xl lg:text-2xl font-heading font-bold mb-2">{project.data.title}</h3>
                <p class="text-gray-200 line-clamp-2 mb-4">{project.data.description}</p>
                <div class="flex flex-wrap gap-2">
                  {project.data.technologies.slice(0, 5).map(tech => (
                    <span class="badge bg-white/20 text-white backdrop-blur">{tech}</span>
                  ))}
                  {project.data.technologies.length > 5 && (
                    <span class="badge bg-white/20 text-white backdrop-blur">+{project.data.technologies.length - 5} more</span>
                  )}
                </div>
              </div>
            </div>

            <div class="p-6 lg:p-8 flex flex-col justify-center">
              <h3 class="text-xl lg:text-2xl font-heading font-bold text-gray-900 dark:text-white mb-3">{project.data.title}</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">{project.data.longDescription || project.data.description}</p>

              {project.data.highlights && project.data.highlights.length > 0 && (
                <div class="mb-6">
                  <h4 class="font-semibold text-gray-900 dark:text-white mb-3">Key Highlights</h4>
                  <ul class="space-y-2" role="list">
                    {project.data.highlights.map(highlight => (
                      <li class="flex items-start gap-2 text-gray-600 dark:text-gray-300">
                        <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="flex flex-wrap gap-3 pt-4 border-t border-gray-100 dark:border-dark-border">
                <a href={withBase(`/project/${project.slug}/`)} class="btn-primary">View Details</a>
                {project.data.projectUrl && (
                  <a href={project.data.projectUrl} target="_blank" rel="noopener noreferrer" class="btn-outline flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    Live Demo
                  </a>
                )}
                {project.data.githubUrl && (
                  <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary flex items-center gap-2">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.305-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                    Code
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Other Projects Grid -->
    <div id="panel-all" role="tabpanel" aria-labelledby="tab-all" class="hidden">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {otherProjects.map((project, index) => (
          <article class="card overflow-hidden animate-fade-in animate-slide-up" style={`animation-delay: ${index * 100}ms`}>
            <div class="relative aspect-video overflow-hidden">
              <img
                src={imageSrc(project.data.image)}
                alt=""
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 hover:opacity-100 transition-opacity duration-300"></div>
              <div class="absolute bottom-4 left-4 right-4 text-white transform translate-y-4 opacity-0 hover:translate-y-0 hover:opacity-100 transition-all duration-300">
                <div class="flex gap-2">
                  <a href={withBase(`/project/${project.slug}/`)} class="btn-primary text-sm px-4 py-2">Details</a>
                  {project.data.projectUrl && (
                    <a href={project.data.projectUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary text-sm px-4 py-2" aria-label="View live demo">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-2">
                <span class="badge-primary text-xs">{project.data.category}</span>
                <span class="text-xs text-gray-500 dark:text-gray-400">
                  {new Date(project.data.startDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                </span>
              </div>
              <h3 class="font-heading font-bold text-gray-900 dark:text-white mb-2 line-clamp-1">{project.data.title}</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-3 line-clamp-2">{project.data.description}</p>
              <div class="flex flex-wrap gap-1">
                {project.data.technologies.slice(0, 4).map(tech => (
                  <span class="badge bg-gray-100 dark:bg-dark-border text-gray-600 dark:text-gray-300 text-xs">{tech}</span>
                ))}
                {project.data.technologies.length > 4 && (
                  <span class="badge bg-gray-100 dark:bg-dark-border text-gray-500 dark:text-gray-400 text-xs">+{project.data.technologies.length - 4}</span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    {categories.filter(c => c !== 'All' && c !== 'Featured').map(cat => (
      <div id={`panel-${cat.toLowerCase()}`} role="tabpanel" aria-labelledby={`tab-${cat.toLowerCase()}`} class="hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {projects.filter(p => p.data.category === cat.toLowerCase()).map((project, index) => (
            <article class="card overflow-hidden animate-fade-in animate-slide-up" style={`animation-delay: ${index * 100}ms`}>
              <div class="relative aspect-video overflow-hidden">
                <img
                  src={imageSrc(project.data.image)}
                  alt=""
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 hover:opacity-100 transition-opacity duration-300"></div>
                <div class="absolute bottom-4 left-4 right-4 text-white transform translate-y-4 opacity-0 hover:translate-y-0 hover:opacity-100 transition-all duration-300">
                  <a href={withBase(`/project/${project.slug}/`)} class="btn-primary text-sm px-4 py-2">View Details</a>
                </div>
              </div>
              <div class="p-5">
                <h3 class="font-heading font-bold text-gray-900 dark:text-white mb-2 line-clamp-1">{project.data.title}</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-3 line-clamp-2">{project.data.description}</p>
                <div class="flex flex-wrap gap-1">
                  {project.data.technologies.slice(0, 4).map(tech => (
                    <span class="badge bg-gray-100 dark:bg-dark-border text-gray-600 dark:text-gray-300 text-xs">{tech}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  // Filter functionality
  const tabs = document.querySelectorAll('.filter-btn');
  const panels = document.querySelectorAll('[role="tabpanel"]');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Update tabs
      tabs.forEach(t => {
        t.classList.remove('bg-primary-500', 'text-white', 'shadow-lg');
        t.classList.add('bg-white', 'dark:bg-dark-card', 'text-gray-600', 'dark:text-gray-300', 'border', 'border-gray-100', 'dark:border-dark-border');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('bg-primary-500', 'text-white', 'shadow-lg');
      tab.classList.remove('bg-white', 'dark:bg-dark-card', 'text-gray-600', 'dark:text-gray-300', 'border', 'border-gray-100', 'dark:border-dark-border');
      tab.setAttribute('aria-selected', 'true');

      // Show/hide panels
      const filter = tab.dataset.filter;
      panels.forEach(panel => {
        if (panel.id === `panel-${filter}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });
</script>