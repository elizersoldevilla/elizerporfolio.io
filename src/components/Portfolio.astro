---
// Portfolio Section Component
import { getCollection } from 'astro:content';
import { withBase, imageSrc } from '@/utils/paths';

const projects = (await getCollection('projects')).sort(
  (a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime()
);

// Only offer filters that actually match at least one project, so the tab row
// never renders a dead-end filter (it previously offered Mobile/Other with 0 items).
const allCategories = ['system', 'web', 'mobile', 'other'] as const;
const presentCategories = allCategories.filter((c) => projects.some((p) => p.data.category === c));

const filters = [
  { key: 'all', label: 'All' },
  { key: 'featured', label: 'Featured' },
  ...presentCategories.map((c) => ({ key: c, label: c.charAt(0).toUpperCase() + c.slice(1) })),
];

const countFor = (key: string) =>
  key === 'all'
    ? projects.length
    : key === 'featured'
      ? projects.filter((p) => p.data.featured).length
      : projects.filter((p) => p.data.category === key).length;

/** Intrinsic size for the card image box; keeps layout stable before load. */
const IMG_W = 800;
const IMG_H = 600;
---

<section id="portfolio" class="section bg-gray-50 dark:bg-dark-card" aria-labelledby="portfolio-heading">
  <div class="container-custom lg:pl-72">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-block px-3 py-1 rounded-full bg-primary-500/10 text-primary-600 dark:text-primary-400 text-sm font-medium mb-4">My Work</span>
      <h2 id="portfolio-heading" class="section-title">Selected Projects</h2>
      <p class="section-subtitle mt-4">
        A collection of systems and applications I've built, ranging from hospital management systems to web applications.
      </p>
    </div>

    <!-- Filter Tabs -->
    <div class="mb-10 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Filter projects by category">
      {filters.map((f, index) => (
        <button
          type="button"
          class:list={[
            'filter-btn rounded-full px-5 py-2.5 text-sm font-medium transition-all duration-200',
            index === 0
              ? 'bg-primary-500 text-white shadow-lg'
              : 'border border-gray-100 bg-white text-gray-600 hover:bg-primary-50 hover:text-primary-600 dark:border-dark-border dark:bg-dark-card dark:text-gray-300 dark:hover:bg-primary-900/20 dark:hover:text-primary-400',
          ]}
          role="tab"
          id={`tab-${f.key}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls="project-grid"
          data-filter={f.key}
        >
          {f.label}
          <span class="ml-1.5 text-xs opacity-70">{countFor(f.key)}</span>
        </button>
      ))}
    </div>

    <p class="sr-only" aria-live="polite" id="filter-status"></p>

    <!-- Single grid; filtering happens client-side so each project is emitted
         once instead of being duplicated across every category panel. -->
    <div
      id="project-grid"
      class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
      role="tabpanel"
      aria-labelledby="tab-all"
    >
      {projects.map((project, index) => (
        <article
          class="project-card card card-fade depth-shadow overflow-hidden"
          style={`animation-delay: ${index * 60}ms`}
          data-category={project.data.category}
          data-featured={project.data.featured ? 'true' : 'false'}
          data-tilt
          data-tilt-max="6"
        >
          <a
            href={withBase(`/project/${project.slug}/`)}
            class="group block h-full focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-dark-card"
          >
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={imageSrc(project.data.image)}
                alt={`Screenshot of ${project.data.title}`}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                width={IMG_W}
                height={IMG_H}
                loading={index < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

              <div class="absolute left-4 top-4 flex gap-2">
                <span class="badge bg-white/90 text-gray-900 backdrop-blur">{project.data.category}</span>
                {project.data.featured && (
                  <span class="badge bg-primary-500 text-white">Featured</span>
                )}
              </div>

              <div class="absolute bottom-4 left-4 right-4 text-white">
                <h3 class="mb-1 font-heading text-lg font-bold leading-snug">
                  {project.data.title}
                </h3>
                <p class="line-clamp-2 text-sm text-gray-200">{project.data.description}</p>
              </div>
            </div>

            <div class="p-5">
              <div class="mb-3 flex flex-wrap gap-1.5">
                {project.data.technologies.slice(0, 4).map((tech) => (
                  <span class="badge bg-gray-100 text-gray-600 dark:bg-dark-border dark:text-gray-300">{tech}</span>
                ))}
                {project.data.technologies.length > 4 && (
                  <span class="badge bg-gray-100 text-gray-500 dark:bg-dark-border dark:text-gray-400">
                    +{project.data.technologies.length - 4}
                  </span>
                )}
              </div>

              <div class="flex items-center justify-between border-t border-gray-100 pt-3 text-sm dark:border-dark-border">
                <span class="text-gray-500 dark:text-gray-400">
                  {new Date(project.data.startDate).toLocaleDateString('en-US', {
                    month: 'short',
                    year: 'numeric',
                  })}
                </span>
                <span class="inline-flex items-center gap-1 font-medium text-primary-500">
                  View details
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <p id="no-results" class="hidden py-12 text-center text-gray-500 dark:text-gray-400">
      No projects in this category yet.
    </p>
  </div>
</section>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.project-card'));
  const status = document.getElementById('filter-status');
  const empty = document.getElementById('no-results');

  function applyFilter(key: string) {
    let visible = 0;

    cards.forEach((card) => {
      const match =
        key === 'all' ||
        (key === 'featured' && card.dataset.featured === 'true') ||
        card.dataset.category === key;

      card.classList.toggle('hidden', !match);
      if (match) {
        visible += 1;
        // A card inside a panel that was hidden could never have triggered its
        // scroll-in reveal, so ask it to show itself now.
        card.dispatchEvent(new CustomEvent('portfolio:reveal'));
      }
    });

    buttons.forEach((btn) => {
      const active = btn.dataset.filter === key;
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
      btn.classList.toggle('bg-primary-500', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('shadow-lg', active);
      btn.classList.toggle('border', !active);
      btn.classList.toggle('border-gray-100', !active);
      btn.classList.toggle('bg-white', !active);
      btn.classList.toggle('text-gray-600', !active);
      btn.classList.toggle('dark:bg-dark-card', !active);
      btn.classList.toggle('dark:text-gray-300', !active);
      btn.classList.toggle('dark:border-dark-border', !active);
    });

    empty?.classList.toggle('hidden', visible > 0);
    if (status) {
      const label = buttons.find((b) => b.dataset.filter === key)?.textContent?.trim() ?? key;
      status.textContent = `Showing ${visible} project${visible === 1 ? '' : 's'} in ${label}.`;
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter ?? 'all'));
  });

  /*
   * A card in a panel that the default filter hides never intersects the
   * viewport, so its scroll-reveal observer cannot fire and it would sit at
   * opacity 0. Reveal whatever the current filter is showing once the page has
   * loaded, so the default view is never full of blank cards.
   */
  function revealVisible() {
    for (const card of document.querySelectorAll<HTMLElement>('.project-card:not(.is-visible)')) {
      if (card.classList.contains('hidden')) continue;
      const r = card.getBoundingClientRect();
      if (r.bottom > 0 && r.top < window.innerHeight) {
        card.dispatchEvent(new CustomEvent('portfolio:reveal'));
      }
    }
  }

  if (document.readyState === 'complete') revealVisible();
  else window.addEventListener('load', revealVisible, { once: true });
</script>