---
// Skills Section Component
import { skillCategories, softSkills, getIconPath } from '@/data/skills';
---

<section id="skills" class="section bg-gray-50 dark:bg-dark-card" aria-labelledby="skills-heading">
  <div class="container-custom lg:pl-72">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-3 py-1 rounded-full bg-primary-500/10 text-primary-600 dark:text-primary-400 text-sm font-medium mb-4">Technical Skills</span>
      <h2 id="skills-heading" class="section-title">Technologies & Expertise</h2>
      <p class="section-subtitle mt-4">
        A comprehensive overview of the technologies, frameworks, and tools I work with daily.
        Continuously learning and expanding my skill set to stay current with industry best practices.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillCategories.map((category, index) => (
        <div class="card card-fade depth-shadow p-6" style={`animation-delay: ${index * 100}ms`} data-tilt data-tilt-max="6">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-xl bg-primary-500/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getIconPath(category.icon)} /></svg>
            </div>
            <h3 class="text-xl font-heading font-semibold text-gray-900 dark:text-white">{category.name}</h3>
          </div>

          <div class="space-y-4">
            {category.skills.map((skill, skillIndex) => (
              <div class="skill-item" style={`animation-delay: ${(index * 100) + (skillIndex * 50)}ms`}>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-medium text-gray-700 dark:text-gray-300">{skill.name}</span>
                  <span class="text-sm font-bold text-primary-500">{skill.level}%</span>
                </div>
                <div class="h-2 bg-gray-100 dark:bg-dark-border rounded-full overflow-hidden">
                  <div
                    class={`h-full rounded-full ${skill.color} transition-all duration-1000 ease-out`}
                    style="width: 0%"
                    data-width={skill.level}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Soft Skills -->
    <div class="mt-16">
      <h3 class="text-2xl font-heading font-bold text-gray-900 dark:text-white text-center mb-8">Core Competencies</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {softSkills.map((skill, index) => (
          <div class="card card-fade depth-shadow p-5" style={`animation-delay: ${index * 100}ms`} data-tilt data-tilt-max="8">
            <div class="flex items-center justify-between mb-3">
              <h4 class="font-semibold text-gray-900 dark:text-white">{skill.name}</h4>
              <span class="text-sm font-bold text-primary-500">{skill.level}%</span>
            </div>
            <div class="h-1.5 bg-gray-100 dark:bg-dark-border rounded-full overflow-hidden mb-2">
              <div
                class={`h-full bg-gradient-to-r from-primary-500 to-primary-600 rounded-full transition-all duration-1000 ease-out`}
                style="width: 0%"
                data-width={skill.level}
              ></div>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400">{skill.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Animate progress bars on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const bars = entry.target.querySelectorAll('[data-width]');
        bars.forEach((bar: HTMLElement) => {
          setTimeout(() => {
            bar.style.width = bar.dataset.width + '%';
          }, 100);
        });
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('.card').forEach(card => {
    observer.observe(card);
  });
</script>